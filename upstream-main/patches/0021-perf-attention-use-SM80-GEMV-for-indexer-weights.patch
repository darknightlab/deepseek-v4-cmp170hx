From 2321799ebc89c715a8b60a6d6451200602b19daa Mon Sep 17 00:00:00 2001
From: Canoziia <canoziia@projectk.org>
Date: Tue, 18 Aug 2026 11:57:13 +0800
Subject: [PATCH 21/26] perf(attention): use SM80 GEMV for indexer weights

---
 vllm/models/deepseek_v4/attention.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/vllm/models/deepseek_v4/attention.py b/vllm/models/deepseek_v4/attention.py
index a6cde2dd45..2525896e4c 100644
--- a/vllm/models/deepseek_v4/attention.py
+++ b/vllm/models/deepseek_v4/attention.py
@@ -15,6 +15,10 @@ from transformers import DeepseekV2Config, DeepseekV3Config
 
 import vllm.envs as envs
 from vllm.compilation.breakable_cudagraph import eager_break_during_capture
+from vllm.model_executor.kernels.linear.gemv_triton import (
+    bf16_gemv,
+    should_use_triton_gemv,
+)
 from vllm.model_executor.layers.linear import (
     ColumnParallelLinear,
     MergedColumnParallelLinear,
@@ -601,6 +605,9 @@ class DeepseekV4Attention(nn.Module, AttentionLayerBase, ABC):
             indexer = self.indexer
 
             def indexer_weights_proj() -> torch.Tensor:
+                w = indexer.weights_proj.weight
+                if should_use_triton_gemv(hidden_states, w):
+                    return bf16_gemv(hidden_states, w)
                 # ReplicatedLinear returns (output, bias); bias is None.
                 weights, _ = indexer.weights_proj(hidden_states)
                 return weights
