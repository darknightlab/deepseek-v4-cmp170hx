diff --git a/vllm/model_executor/kernels/mhc/triton.py b/vllm/model_executor/kernels/mhc/triton.py
index facb681..cccbb64 100644
--- a/vllm/model_executor/kernels/mhc/triton.py
+++ b/vllm/model_executor/kernels/mhc/triton.py
@@ -8,6 +8,56 @@ from vllm.triton_utils import tl, triton
 from vllm.utils.torch_utils import direct_register_custom_op
 
 
+@triton.jit
+def _row_sqrsum_kernel(
+    x_ptr,
+    out_ptr,
+    stride_row,
+    K,
+    BLOCK_K: tl.constexpr,
+):
+    """Compute one fp32 square-sum per input row."""
+    row = tl.program_id(0)
+    offs = tl.arange(0, BLOCK_K)
+    acc = tl.zeros([BLOCK_K], dtype=tl.float32)
+    for k0 in range(0, K, BLOCK_K):
+        x = tl.load(
+            x_ptr + row * stride_row + k0 + offs,
+            mask=k0 + offs < K,
+            other=0.0,
+            eviction_policy="evict_first",
+        ).to(tl.float32)
+        acc += x * x
+    tl.store(out_ptr + row, tl.sum(acc))
+
+
+def hc_prenorm_gemm_cublas(
+    x: Tensor,
+    fn: Tensor,
+    out: Tensor,
+    sqrsum: Tensor,
+) -> None:
+    """Run the large-token mHC prenorm projection through BF16 cuBLAS."""
+    assert out.shape[0] == 1
+    assert sqrsum.shape[0] == 1
+
+    fn_bf16 = getattr(fn, "_hc_prenorm_bf16", None)
+    if fn_bf16 is None:
+        fn_bf16 = fn.to(torch.bfloat16)
+        fn._hc_prenorm_bf16 = fn_bf16
+
+    num_rows, k = x.shape
+    out[0].copy_(x @ fn_bf16.t())
+    _row_sqrsum_kernel[(num_rows,)](
+        x,
+        sqrsum[0],
+        x.stride(0),
+        k,
+        BLOCK_K=1024,
+        num_warps=4,
+    )
+
+
 @triton.jit
