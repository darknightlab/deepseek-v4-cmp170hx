From c0e5e9dea6dae5021bdb2767ece58a3b08974844 Mon Sep 17 00:00:00 2001
From: Canoziia <canoziia@projectk.org>
Date: Tue, 18 Aug 2026 11:54:23 +0800
Subject: [PATCH 09/26] perf(allreduce): make custom-AR buffer capacity
 configurable

---
 vllm/distributed/device_communicators/cuda_communicator.py | 4 ++++
 vllm/envs.py                                               | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/vllm/distributed/device_communicators/cuda_communicator.py b/vllm/distributed/device_communicators/cuda_communicator.py
index 06b441c5a4..c95bae855d 100644
--- a/vllm/distributed/device_communicators/cuda_communicator.py
+++ b/vllm/distributed/device_communicators/cuda_communicator.py
@@ -9,6 +9,7 @@ import vllm.envs as envs
 from vllm._aiter_ops import rocm_aiter_ops
 from vllm.distributed.device_communicators.all_reduce_utils import (
     NCCL_SYMM_MEM_ALL_REDUCE_CONFIG,
+    MiB,
     should_nccl_symm_mem_ag_rs,
     should_nccl_symm_mem_allreduce,
 )
@@ -116,12 +117,15 @@ class CudaCommunicator(DeviceCommunicatorBase):
 
         if use_custom_allreduce and self.aiter_ar_comm is None and self.world_size > 1:
             # Initialize a custom fast all-reduce implementation.
+            max_size_mb = envs.VLLM_MAX_SIZE_MB_CUSTOM_ALL_REDUCE
+            extra = {} if max_size_mb is None else {"max_size": max_size_mb * MiB}
             self.ca_comm = CustomAllreduce(
                 group=self.cpu_group,
                 device=self.device,
                 symm_mem_enabled=(
                     self.symm_mem_comm is not None and not self.symm_mem_comm.disabled
                 ),
+                **extra,
             )
 
         if use_custom_allreduce and self.world_size > 1 and current_platform.is_rocm():
diff --git a/vllm/envs.py b/vllm/envs.py
index edce389f33..84f0919a67 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -265,6 +265,7 @@ if TYPE_CHECKING:
     VLLM_ROCM_FP8_MFMA_PAGE_ATTN: bool = False
     VLLM_ALLREDUCE_USE_SYMM_MEM: bool = True
     VLLM_ALLREDUCE_USE_FLASHINFER: bool = False
+    VLLM_MAX_SIZE_MB_CUSTOM_ALL_REDUCE: int | None = None
     VLLM_DETERMINISTIC_MOE_ALIGN: bool = False
     VLLM_TUNED_CONFIG_FOLDER: str | None = None
     VLLM_ENABLE_STARTUP_PLAN: bool = False
@@ -1883,6 +1884,9 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_ALLREDUCE_USE_FLASHINFER": lambda: bool(
         int(os.getenv("VLLM_ALLREDUCE_USE_FLASHINFER", "0"))
     ),
+    "VLLM_MAX_SIZE_MB_CUSTOM_ALL_REDUCE": lambda: maybe_convert_int(
+        os.environ.get("VLLM_MAX_SIZE_MB_CUSTOM_ALL_REDUCE", None)
+    ),
     "VLLM_DETERMINISTIC_MOE_ALIGN": lambda: bool(
         int(os.getenv("VLLM_DETERMINISTIC_MOE_ALIGN", "0"))
     ),
