index 0000000000..33d94616f6
--- /dev/null
+++ b/tests/v1/simple_kv_offload/test_disk_backend.py
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import torch
+
+from vllm.v1.simple_kv_offload import cuda_mem_ops
+from vllm.v1.simple_kv_offload.disk_backend import (
+    _alloc_aligned,
+    aligned_disk_slot_bytes,
+)
+
+
+def test_aligned_disk_slot_bytes():
+    assert aligned_disk_slot_bytes(4096) == 4096
+    assert aligned_disk_slot_bytes(4097) == 8192
+    assert aligned_disk_slot_bytes(332928) == 335872
+    assert aligned_disk_slot_bytes(299520) == 303104
+
+
+def test_aligned_pool_rows():
+    stride = aligned_disk_slot_bytes(332928)
+    pool = _alloc_aligned(3, stride)
+    assert pool.data_ptr() % 4096 == 0
+    assert pool.stride(0) == stride
+    assert pool[1].data_ptr() % 4096 == 0
+
+
+def test_batch_memcpy_supports_distinct_block_strides(monkeypatch):
+    monkeypatch.setattr(cuda_mem_ops, "_batch_memcpy_fn", object())
+
+    src = torch.empty((2, 13), dtype=torch.int8)
+    backing = torch.empty((2, 16), dtype=torch.int8)
+    dst = backing.as_strided((2, 13), (16, 1))
+
+    class FakeStream:
+        cuda_stream = 0
+
+    params = cuda_mem_ops.build_params(
+        {"cache": src},
+        {"cache": dst},
+        FakeStream(),  # type: ignore[arg-type]
+    )
+    assert params.src_strides.tolist() == [13]
+    assert params.dst_strides.tolist() == [16]
+    assert params.copy_sizes.tolist() == [13]
