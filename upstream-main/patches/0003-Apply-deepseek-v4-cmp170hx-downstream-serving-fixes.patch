+                    total_rows = q_slice_cast.shape[0]
+                    use_torch_topk = _prefill_topk_needs_torch_fallback()
+                    for row_start in range(0, total_rows, step):
+                        row_end = min(row_start + step, total_rows)
+                        chunk_logits = fp8_mqa_logits_triton(
+                            q_slice_cast[row_start:row_end],
+                            (k_quant_cast, k_scale_cast),
+                            weights[
+                                chunk.token_start + row_start : chunk.token_start
