From 050c7ec4b741ef4dae223ac9d150c9c0e3bb37db Mon Sep 17 00:00:00 2001
From: Canoziia <canoziia@projectk.org>
Date: Tue, 18 Aug 2026 11:13:26 +0800
Subject: [PATCH 14/26] perf(streams): guard and control side-stream execution

---
 vllm/envs.py                     |  4 ++++
 vllm/utils/multi_stream_utils.py | 14 ++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/vllm/envs.py b/vllm/envs.py
index 853202a9bb..a78e6ce9c0 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -268,6 +268,7 @@ if TYPE_CHECKING:
     VLLM_ALLREDUCE_USE_FLASHINFER: bool = False
     VLLM_MAX_SIZE_MB_CUSTOM_ALL_REDUCE: int | None = None
     VLLM_HIER_ALL_REDUCE: str = ""
+    VLLM_DISABLE_MULTI_STREAM_PARALLEL: bool = False
     VLLM_DETERMINISTIC_MOE_ALIGN: bool = False
     VLLM_TUNED_CONFIG_FOLDER: str | None = None
     VLLM_ENABLE_STARTUP_PLAN: bool = False
@@ -1893,6 +1894,9 @@ environment_variables: dict[str, Callable[[], Any]] = {
         os.environ.get("VLLM_MAX_SIZE_MB_CUSTOM_ALL_REDUCE", None)
     ),
     "VLLM_HIER_ALL_REDUCE": lambda: os.getenv("VLLM_HIER_ALL_REDUCE", ""),
+    "VLLM_DISABLE_MULTI_STREAM_PARALLEL": lambda: bool(
+        int(os.getenv("VLLM_DISABLE_MULTI_STREAM_PARALLEL", "0"))
+    ),
     "VLLM_DETERMINISTIC_MOE_ALIGN": lambda: bool(
         int(os.getenv("VLLM_DETERMINISTIC_MOE_ALIGN", "0"))
     ),
diff --git a/vllm/utils/multi_stream_utils.py b/vllm/utils/multi_stream_utils.py
index a8286c8480..ffb208578a 100644
--- a/vllm/utils/multi_stream_utils.py
+++ b/vllm/utils/multi_stream_utils.py
@@ -7,6 +7,8 @@ from typing import Any
 
 import torch
 
+import vllm.envs as envs
+
 
 class EventType(Enum):
     Main = 0
@@ -42,6 +44,8 @@ def maybe_execute_in_parallel(
     Returns:
         Tuple of (fn0_result, fn1_result).
     """
+    if envs.VLLM_DISABLE_MULTI_STREAM_PARALLEL:
+        aux_stream = None
     if aux_stream is not None:
         from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
 
@@ -101,6 +105,16 @@ def execute_in_parallel(
         Tuple of (default_result, aux_results) where aux_results[i] is the
         result of aux_fns[i] (or None when skipped).
     """
+    if envs.VLLM_DISABLE_MULTI_STREAM_PARALLEL:
+        aux_streams = None
+    if aux_streams is not None and enable:
+        from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+        # Same rule as maybe_execute_in_parallel: no side-stream forks while
+        # a breakable capture is recording the surrounding segment.
+        if BreakableCUDAGraphCapture.is_active():
+            aux_streams = None
+
     aux_results: list[Any]
     if aux_streams is None or not enable:
         default_result = default_fn()
