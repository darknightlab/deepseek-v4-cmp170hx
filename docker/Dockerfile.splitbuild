# Layered build of haosdent/vllm@dsv4-flash-a100 (c3046d1 base).
#
# LAYER MAP (why this is as good as it gets for THIS tree):
#   [stable]  apt python/venv/build tools          <- cached forever
#   [stable]  rust 1.95 toolchain                 <- cached forever
#   [stable]  torch family                        <- cached forever (largest win)
#   [build]   COPY . + pip install -e .   (~115 min csrc compile, ONE time)
#   [merge]   COPY 之后 Python 迭代请用 podman cp + commit 附加层,
#            不要重跑 docker build（见下 "Iteration"）。
#
# WHY NOT a thinner Dockerfile split: this is an EDITABLE (-e .) install whose
# csrc compilation reads the WHOLE tree. Splitting `COPY .` apart doesn't help:
# the layer AFTER a COPY reruns whenever that COPY's content hash changes, so any
# source edit still re-triggers the compile layer. The toolchain layers above are
# what a rebuild actually saves; source edits are cheap ONLY via commit-layering.
#
# Iteration (do this, it is the correct workflow for editable vLLM):
#   cid=$(podman create <img> sleep 300)
#   podman cp changed/file.py $cid:/vllm/vllm/path/file.py
#   podman commit $cid darknightlab/vllm-170hx:latest
#   (= exactly the flow we already use; keep using it)
FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv git build-essential curl \
        ca-certificates ccache cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/lib/ccache:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV CUDA_HOME=/usr/local/cuda
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
ENV TORCH_CUDA_ARCH_LIST=8.0
ENV MAX_JOBS=32
ENV CMAKE_BUILD_TYPE=Release
ENV VLLM_TARGET_DEVICE=cuda

WORKDIR /vllm

# --- STABLE: build toolchain + torch (cached across every future rebuild) ---
RUN pip install --no-cache-dir -U pip "setuptools>=77.0.3,<81.0.0" wheel \
        "setuptools-scm>=8.0" "setuptools-rust>=1.9.0" ninja "cmake>=3.26.1" \
        "packaging>=24.2" jinja2
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain 1.95 --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
RUN pip install --no-cache-dir torch==2.13.0 torchaudio==2.11.0 torchvision==0.28.0

# --- BUILD: compile the editable vLLM (source tree; csrc changes here) ---
COPY . /vllm/
RUN rustc --version && pip install --no-cache-dir -e . --no-build-isolation

# --- VERIFY ---
RUN nvcc --version | tail -2  && python3 -c "import vllm, torch; print('vllm', vllm.__version__, 'torch', torch.__version__)"  && ls -la /vllm/vllm/*.so  && python3 -c "import torch, vllm; import vllm._custom_ops as o; print('custom ops import OK')"
