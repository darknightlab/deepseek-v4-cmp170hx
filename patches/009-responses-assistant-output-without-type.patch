+
+
+def test_assistant_output_style_content_without_type_coerced():
+    """Assistant output-message content without a top-level type is
+    normalized for clients that replay response output as conversation input."""
+    request_data = {
+        "model": "test-model",
+        "input": [
+            {
+                "role": "assistant",
+                "content": [{"type": "output_text", "text": "world"}],
+            },
+        ],
+    }
+
+    request = ResponsesRequest(**request_data)
+
+    item = request.input[0]
+    assert isinstance(item, ResponseOutputMessage), (
+        "Output-style assistant message without type should be coerced to "
+        f"ResponseOutputMessage, got {type(item)}"
+    )
+    assert item.content[0].text == "world"
+    assert item.content[0].annotations == []
+    assert item.status == "completed"
+    assert item.id.startswith("msg_")
